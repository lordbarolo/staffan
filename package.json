{
  "name": "staffan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @staffan/db migrate",
    "db:smoke": "pnpm --filter @staffan/db verify",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "pnpm --filter @staffan/db build && pnpm --parallel --filter @staffan/api --filter @staffan/web dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --filter @staffan/db build && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
