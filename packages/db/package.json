{
  "name": "@staffan/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "pnpm build && node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm build && node dist/verify.js"
  },
  "dependencies": {
    "@staffan/core": "workspace:*",
    "@staffan/ingress": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
