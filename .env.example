# Local development only. Never commit real credentials.
DATABASE_URL=postgres://staffan:staffan@localhost:5432/staffan
API_HOST=127.0.0.1
API_PORT=3001
INTERNAL_API_URL=http://127.0.0.1:3001

# Required local operator authentication. Generate the hash with `pnpm auth:hash-password`.
# Store only the generated hash, never the plaintext password.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=replace-with-generated-scrypt-hash
AUTH_SESSION_TTL_HOURS=12
# Local HTTP only. Set true before HTTPS deployment or sharing.
AUTH_COOKIE_SECURE=false
# Direct OpenAI is the normal local provider. Keep the key only in .env or a deployment secret store.
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-me
MODEL_NAME=gpt-5.4-mini-2026-03-17
MODEL_VERSION=2026-03-17

# Optional alternative provider behind the generic HTTP ModelGateway.
# MODEL_PROVIDER=http
# MODEL_GATEWAY_URL=http://127.0.0.1:4100/extract
# MODEL_GATEWAY_TOKEN=replace-me

# Optional until the e-Avrop adapter is used. Keep real credentials only in .env or the deployment secret store.
EAVROP_USERNAME=replace-me
EAVROP_PASSWORD=replace-me
# EAVROP_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# OCR is invoked only for PDF pages without enough embedded text. Docker includes Tesseract
# with Swedish and English language data; set this path only when it is not discoverable locally.
# OCR_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Required only by the separate background worker. Point to the authenticated e-Avrop list
# that contains links to current staffing call-offs.
# EAVROP_POLL_URL=https://www.e-avrop.com/path/to/calloff-list
# EAVROP_POLL_CRON=*/5 * * * *
# EAVROP_POLL_TIME_ZONE=Europe/Stockholm
# WORKER_IMPORT_MAX_ATTEMPTS=5
