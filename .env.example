# Local development only. Never commit real credentials.
DATABASE_URL=postgres://staffan:staffan@localhost:5432/staffan
API_HOST=127.0.0.1
API_PORT=3001
INTERNAL_API_URL=http://127.0.0.1:3001
# Direct OpenAI is the normal local provider. Keep the key only in .env or a deployment secret store.
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-me
MODEL_NAME=gpt-5.4-mini-2026-03-17
MODEL_VERSION=2026-03-17

# Optional alternative provider behind the generic HTTP ModelGateway.
# MODEL_PROVIDER=http
# MODEL_GATEWAY_URL=http://127.0.0.1:4100/extract
# MODEL_GATEWAY_TOKEN=replace-me

# Optional until the e-Avrop adapter is used. Keep real credentials only in .env or the deployment secret store.
EAVROP_USERNAME=replace-me
EAVROP_PASSWORD=replace-me
# EAVROP_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
